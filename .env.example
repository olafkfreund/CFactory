# CFactory environment configuration — copy to .env and adjust.
#
# Every value below is a COMMENTED default; uncomment and edit to override.
# Do NOT put real secrets in this file. The backend reads CFACTORY_* via the
# Settings class (apps/backend/cfactory/config.py, env_prefix "CFACTORY_"), plus
# CFACTORY_STALL_DEADLINE_SECONDS directly in store.py. Full reference:
# techdocs/dependencies.md.

# ── Server ───────────────────────────────────────────────────────────────────
#CFACTORY_BACKEND_PORT=3111
#CFACTORY_FRONTEND_PORT=3110
#CFACTORY_WORKSPACE_ROOT=~/.cfactory

# ── Upstream factory endpoints (adapters poll these) ─────────────────────────
#CFACTORY_AIFACTORY_API_URL=http://localhost:3101
#CFACTORY_PFACTORY_API_URL=http://localhost:3105
#CFACTORY_TFACTORY_API_URL=http://localhost:3103
# OpenObserve health-probe base (Services view only; not a PARR factory).
# In-cluster: http://observe.factory.svc.cluster.local:5080
#CFACTORY_OBSERVE_API_URL=http://localhost:5080

# ── Upstream auth (leave unset for local dev with APP_DISABLE_AUTH=true) ──────
# Shared bearer token sent to PFactory/AIFactory/TFactory. Server-side only.
#CFACTORY_UPSTREAM_TOKEN=
# Token for AIFactory's live-agent console WS; falls back to UPSTREAM_TOKEN.
#CFACTORY_AIFACTORY_TOKEN=

# ── Correlation store ────────────────────────────────────────────────────────
# Postgres connection string. Unset = local SQLite under the workspace root.
#CFACTORY_DATABASE_URL=

# ── Live progress / liveness ─────────────────────────────────────────────────
# Connect to each upstream /api/ws feed at startup.
#CFACTORY_SUBSCRIBE_UPSTREAMS=false
# Poll PFactory/TFactory + subscribe AIFactory progress.
#CFACTORY_LIVE_PROGRESS=false
# Live-progress poll interval, seconds (only when LIVE_PROGRESS is on).
#CFACTORY_POLL_INTERVAL_SECONDS=3.0
# Idle budget (seconds) before an active stage is flagged stalled.
#CFACTORY_STALL_DEADLINE_SECONDS=900.0

# ── Copilot ──────────────────────────────────────────────────────────────────
# Model id; meaning depends on CFACTORY_COPILOT_PROVIDER.
#CFACTORY_COPILOT_MODEL=claude-opus-4-8
# "claude" (Claude Agent SDK, reads ANTHROPIC_API_KEY) or
# "ollama"/"openai_compatible" (OpenAI-compatible chat endpoint).
#CFACTORY_COPILOT_PROVIDER=claude
# OpenAI-compatible base URL (includes /v1). Bare OLLAMA_CLOUD_BASE_URL also works.
#CFACTORY_OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Bearer key for the OpenAI-compatible endpoint. Bare OLLAMA_API_KEY also works.
#CFACTORY_OLLAMA_API_KEY=
# Claude Agent SDK credential (used when copilot provider is "claude").
#ANTHROPIC_API_KEY=

# ── Auth / multi-tenant / audit ──────────────────────────────────────────────
# Scoped API keys "<key>:read,write;<key2>:read". Unset = auth OPEN (local mode).
#CFACTORY_API_KEYS=
# Bearer token the MCP transport (POST /mcp) requires. Unset = MCP open (dev).
#CFACTORY_MCP_SECRET=
# Public base URL of the token-gated API, shown on /settings/token (display only).
#CFACTORY_PUBLIC_API_URL=
# Resolve tenant per request from the X-Tenant-Id header (hosted).
#CFACTORY_MULTI_TENANT=false
# HMAC secret anchoring the tamper-evident audit chain. MUST be set to a real
# secret in any hosted/shared deploy (the built-in default is a dev value).
#CFACTORY_AUDIT_HMAC_SECRET=

# ── Frontend build-time (VITE_*) ─────────────────────────────────────────────
# Read at BUILD time by Vite and inlined into the static bundle (not runtime env).
# Set as build args when running `npm run build`. All have hard-coded fallbacks.
# OpenObserve dashboard URL; unset = the observe link is hidden.
#VITE_OBSERVE_URL=
#VITE_PFACTORY_URL=https://pfactory.freundcloud.org.uk
#VITE_AIFACTORY_URL=https://aifactory.freundcloud.org.uk
#VITE_TFACTORY_URL=https://tfactory.freundcloud.org.uk
