# Rendered by nginx's envsubst entrypoint: only ${BACKEND_URL} is substituted
# (nginx runtime $vars like $host/$uri/$http_upgrade are preserved).

# WebSocket upgrade plumbing for the /api/ws cockpit feed.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Hashed assets under /assets are immutable and safely long-cached.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The entry document must NEVER be cached (browser or CDN) or new deploys
    # won't be picked up — clients keep loading the old bundle hash and see stale
    # UI no matter how often they refresh. Applies to the SPA fallback too, since
    # try_files below internal-redirects here.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    # SPA fallback — client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API (incl. the /api/ws WebSocket) → backend.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        # Token-gated API: inject the CFactory key so the browser cockpit keeps
        # working once the keystore is enforced. Browser users are already past
        # oauth2-proxy upstream; the editor sends its own bearer on a separate
        # host. Empty in open mode (no key set) → a harmless "Bearer " the open
        # keystore ignores. Applies to the /api/ws upgrade too.
        proxy_set_header Authorization     "Bearer ${CFACTORY_API_KEY}";
        proxy_read_timeout 3600s;
    }

    # Editor token hand-off (#73). The factory-vscode extension opens
    # /connect/vscode in the browser; it must reach the backend (which 302s back
    # to the editor's vscode:// callback), not the SPA fallback above. Note that
    # /settings/token stays an SPA route — only /connect/ proxies to the backend.
    location /connect/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Inject the CFactory key (see /api/ above) so the browser hand-off works
        # under an enforced keystore. Empty/no-op in open mode.
        proxy_set_header Authorization     "Bearer ${CFACTORY_API_KEY}";
    }

    # Agent capability manifest (RFC-0019 §3.4) → backend. Needs its own location
    # or the SPA fallback above would answer with index.html. No Authorization is
    # injected: the manifest is public metadata an agent reads before it holds a
    # token, and the backend does not gate this path.
    location = /.well-known/agent-skills/index.json {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Health passthrough (used by the cockpit's BackendPill).
    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }
}
