# Rendered by nginx's envsubst entrypoint: only ${BACKEND_URL} is substituted
# (nginx runtime $vars like $host/$uri/$http_upgrade are preserved).

# WebSocket upgrade plumbing for the /api/ws cockpit feed.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Hashed assets under /assets are immutable and safely long-cached.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The entry document must NEVER be cached (browser or CDN) or new deploys
    # won't be picked up — clients keep loading the old bundle hash and see stale
    # UI no matter how often they refresh. Applies to the SPA fallback too, since
    # try_files below internal-redirects here.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    # SPA fallback — client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API (incl. the /api/ws WebSocket) → backend.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # Health passthrough (used by the cockpit's BackendPill).
    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }
}
