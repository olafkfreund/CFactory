{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "schedule": ["before 9am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,

  "pinDigests": true,
  "dockerfile": {
    "fileMatch": ["(^|/)Dockerfile([^/]*)?$"]
  },

  "packageRules": [
    {
      "description": "Base image digest updates: deliberate, never auto-merged.",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "labels": ["dependencies", "docker", "base-image"],
      "commitMessageTopic": "{{depName}} digest",
      "automerge": false
    },
    {
      "description": "GitHub Actions pinned by SHA per supply-chain best practice.",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "labels": ["dependencies", "ci"]
    },
    {
      "description": "The Claude Agent SDK powers the cockpit's LLM conductor; treat a bump as a reviewed change, never auto-merged.",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["claude-agent-sdk", "anthropic"],
      "labels": ["dependencies", "agent-sdk"],
      "automerge": false
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  }
}
