            }
          }
        }
      }
    },
    "/api/copilot/ask": {
      "post": {
        "summary": "Copilot Ask",
        "operationId": "copilot_ask_api_copilot_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Copilot Ask Api Copilot Ask Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "CompletionEvent": {
        "properties": {
          "correlation_key": {
            "type": "string",
            "title": "Correlation Key"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "correlation_key",
          "service",
          "task_id",
          "status",
          "updated_at"
        ],
        "title": "CompletionEvent",
        "description": "Normalized completion envelope emitted by the three services (see Factory#4).\n\nStandard schema all services conform to; consumed by the webhook ingress (#11).\nThe optional ``usage`` block (RFC-0001 v1.1) carries per-stage token/cost."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PreparedAction": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "approve_gate",
              "trigger_handoff",
              "kick_handback"
            ],
            "title": "Kind"
          },
          "correlation_key": {
            "type": "string",
            "title": "Correlation Key"
          },
          "target_service": {
            "type": "string",
            "title": "Target Service"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "correlation_key",
          "target_service",
          "method",
          "endpoint",
          "payload",
          "rationale"
        ],
        "title": "PreparedAction",
        "description": "A fully-described, not-yet-executed write against an upstream service."
      },
      "ProposeRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "correlation_key": {
            "type": "string",
            "title": "Correlation Key"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "correlation_key"
        ],
        "title": "ProposeRequest"
      },
      "Service": {
        "type": "string",
        "enum": [
          "pfactory",
          "aifactory",
          "tfactory"
        ],
        "title": "Service"
      },
      "TokenUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "type": "object",
        "title": "TokenUsage",
        "description": "LLM token/cost usage for one stage (RFC-0001 v1.1 additive `usage` block).\n\nOptional everywhere \u2014 only present when a service instruments and emits it\n(AIFactory does today; PFactory/TFactory pending). Aggregated by CFactory."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}